rules_version = '2';

// Reglas de seguridad — Acá Falta la Muni (Carlos Casares)
//
// Principios:
//  - Los reclamos son públicos y de solo lectura una vez creados.
//  - Desde la web solo se puede crear un reclamo y sumar apoyos (+1 de a uno).
//  - Cambiar estado (resuelto / en revisión) u ocultar un reclamo se hace
//    únicamente desde la consola de Firebase (o un panel admin futuro con login).
//  - Los datos de contacto de los vecinos van a una colección que NADIE puede leer desde la web.

service cloud.firestore {
  match /databases/{database}/documents {

    function validCategory(c) {
      return c in ['accesibilidad', 'agua', 'ambiente', 'animales', 'calles', 'espacios',
                   'iluminacion', 'inundaciones', 'limpieza', 'transito', 'otros'];
    }

    // Rectángulo del Partido de Carlos Casares (igual que LIMITES_PARTIDO en src/config/ciudad.ts)
    function insidePartido(d) {
      return d.latitude is number && d.longitude is number
        && d.latitude >= -36.08 && d.latitude <= -35.37
        && d.longitude >= -61.73 && d.longitude <= -61.02;
    }

    function shortString(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    function validNewReport(id, d) {
      return d.keys().hasOnly(['id', 'created_at', 'description', 'category', 'sector', 'is_rural',
                               'address', 'latitude', 'longitude', 'previously_reported',
                               'status', 'support_count', 'is_hidden'])
        && d.keys().hasAll(['id', 'created_at', 'description', 'category', 'sector', 'is_rural',
                            'address', 'latitude', 'longitude', 'previously_reported',
                            'status', 'support_count', 'is_hidden'])
        && d.id == id
        && shortString(d.created_at, 20, 30)
        && shortString(d.description, 5, 1000)
        && validCategory(d.category)
        && shortString(d.sector, 2, 60)
        && d.is_rural is bool
        && shortString(d.address, 0, 160)
        && insidePartido(d)
        && d.previously_reported is bool
        // Valores iniciales fijos: nadie puede crear un reclamo ya "resuelto", oculto o con apoyos inflados
        && d.status == 'pendiente'
        && d.support_count == 0
        && d.is_hidden == false;
    }

    match /reports/{reportId} {
      allow read: if true;
      // La foto es obligatoria: el reclamo solo se acepta si en la misma operación se crea su foto
      allow create: if validNewReport(reportId, request.resource.data)
        && existsAfter(/databases/$(database)/documents/photos/$(reportId));

      // Único cambio permitido desde la web: sumar exactamente +1 apoyo.
      // (Sin login no se puede atar el apoyo a una persona; ver "Próximos pasos" en el README.)
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['support_count'])
        && request.resource.data.support_count == resource.data.support_count + 1;

      allow delete: if false;
    }

    // Fotos: un documento por reclamo, con el mismo id. Se lee solo al abrir el reclamo.
    match /photos/{reportId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['report_id', 'image_url', 'created_at'])
        && request.resource.data.report_id == reportId
        && shortString(request.resource.data.created_at, 20, 30)
        // Foto comprimida en el navegador (data URL de imagen, máx ~700 KB)
        && request.resource.data.image_url is string
        && request.resource.data.image_url.size() <= 700000
        && request.resource.data.image_url.matches('^data:image/(webp|jpeg|png);base64,.*')
        // Solo junto con un reclamo nuevo (no se puede agregar ni cambiar la foto de uno existente)
        && !exists(/databases/$(database)/documents/reports/$(reportId))
        && existsAfter(/databases/$(database)/documents/reports/$(reportId));
      allow update, delete: if false;
    }

    // Un apoyo por dispositivo y reclamo (el id del documento es reportId_deviceId)
    match /supports/{supportId} {
      allow read: if false;
      allow create: if request.resource.data.keys().hasOnly(['report_id', 'device_id', 'created_at'])
        && shortString(request.resource.data.report_id, 3, 80)
        && shortString(request.resource.data.device_id, 3, 80)
        && supportId == request.resource.data.report_id + '_' + request.resource.data.device_id
        && exists(/databases/$(database)/documents/reports/$(request.resource.data.report_id));
      allow update, delete: if false;
    }

    // Datos de contacto: se pueden dejar, pero no leer. Se consultan desde la consola de Firebase.
    match /contacts/{reportId} {
      allow read: if false;
      allow create: if request.resource.data.keys().hasOnly(['report_id', 'first_name', 'last_name', 'phone', 'created_at'])
        && request.resource.data.report_id == reportId
        && shortString(request.resource.data.first_name, 0, 60)
        && shortString(request.resource.data.last_name, 0, 60)
        && shortString(request.resource.data.phone, 0, 30)
        && shortString(request.resource.data.created_at, 20, 30)
        && existsAfter(/databases/$(database)/documents/reports/$(reportId));
      allow update, delete: if false;
    }

    // Todo lo demás, cerrado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
